# Copie ce fichier en .env et remplis les valeurs (le .env n'est jamais committé)

# Fine-grained Personal Access Token GitHub
# Scope : le dépôt cible UNIQUEMENT, permission : Contents: Read and write
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxx

# Dépôt cible (format propriétaire/nom)
GITHUB_REPO=DimalaxYT/bgh

# Branche cible
GITHUB_BRANCH=main

# Requis par le scaffold Prisma (non utilisé par bgh pusher)
DATABASE_URL=file:./db/custom.db
